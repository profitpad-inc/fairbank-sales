    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// The JWT node checked the signature and expiry with the session secret.\nconst cfg = $('Read token').first().json;\nconst r = $input.first().json;\nconst deny = (msg) => [{ json: { ok: false, statusCode: 401, body: { error: msg } } }];\nif (r.error) return deny('Session is not valid. Sign in again.');\nconst c = r.payload || r;\nif (String(c.hub_id || '') !== cfg.HUB_ID || c.iss !== 'fairbank-sales') return deny('Session is not valid. Sign in again.');\nconst hsUserId = String(c.sub || '');\nconst email = String(c.email || '').trim().toLowerCase();\nif (!hsUserId && !email) return deny('Session is not valid. Sign in again.');\nconst userProps = [\n  'e_user_id', 'e_default_branch', 'e_territory', 'hs_internal_user_id',\n  'hs_given_name', 'hs_family_name', 'hs_email', 'hs_searchable_calculated_name',\n];\nconst groups = [];\nif (hsUserId) groups.push({ filters: [{ propertyName: 'hs_internal_user_id', operator: 'EQ', value: hsUserId }] });\nif (email) groups.push({ filters: [{ propertyName: 'hs_email', operator: 'EQ', value: email }] });\nreturn [{ json: { ok: true, old: c, hsUserId, email, userProps, filter: { filterGroups: groups } } }];\n"
      },
