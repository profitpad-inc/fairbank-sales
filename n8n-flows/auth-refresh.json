    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Re-reads the rep from HubSpot so a user removed from HubSpot (or whose\n// e_user_id was cleared) cannot keep extending a session. Same property\n// names as auth-hubspot / user-lookup.\nconst PROPS = { idProp: 'e_user_id', branchProp: 'e_default_branch', territoryProp: 'e_territory' };\nconst cfg = $('Read token').first().json;\nconst who = $('Check session').first().json;\nconst r = $input.first().json;\nconst deny = (status, msg) => [{ json: { ok: false, statusCode: status, body: { error: msg } } }];\nif (r.error) return deny(502, 'HubSpot user lookup failed.');\nconst results = Array.isArray(r.results) ? r.results : (r.id ? [r] : []);\nconst u = results.find(x => String((x.properties || {}).hs_internal_user_id || '') === who.hsUserId)\n  || results.find(x => String((x.properties || {}).hs_email || '').toLowerCase() === who.email);\nif (!u) return deny(401, 'Your HubSpot user was not found in the Fairbank account. Sign in again.');\nconst p = u.properties || {};\nconst eUserId = String(p[PROPS.idProp] || '').trim().toUpperCase();\nif (!eUserId) return deny(401, 'Your HubSpot user has no Eclipse user ID (e_user_id). Ask an admin to add it.');\nconst now = Math.floor(Date.now() / 1000);\nconst old = who.old;\nconst name = [p.hs_given_name, p.hs_family_name].filter(Boolean).join(' ') || p.hs_searchable_calculated_name || '';\nreturn [{ json: { ok: true, claims: {\n  iss: 'fairbank-sales',\n  sub: who.hsUserId || String(u.id || ''),\n  iat: now,\n  auth_time: Number(old.auth_time || old.iat || now),\n  exp: now + cfg.SESSION_HOURS * 3600,\n  hub_id: cfg.HUB_ID,\n  e_user_id: eUserId,\n  name,\n  email: p.hs_email || who.email,\n  default_branch: p[PROPS.branchProp] || '',\n  territory: p[PROPS.territoryProp] || '',\n  hs_user_id: String(u.id || ''),\n  hs_owner_id: String((u.owner && u.owner.id) || ''),\n} } }];\n"
      },
