        "jsCode": "// Config. SESSION_HOURS must match the sign-in flow (auth-hubspot).\nconst CONFIG = { HUB_ID: '43793456', SESSION_HOURS: 48 };\nconst h = $input.first().json.headers || {};\nconst m = String(h.authorization || '').match(/^Bearer\\s+(\\S+)$/i);\nif (!m) return [{ json: { ok: false, statusCode: 401, body: { error: 'No session token.' } } }];\nreturn [{ json: { ok: true, token: m[1], ...CONFIG } }];\n"
