   ],
   "parameters": {
    "jsCode": "// AssemblyAI answers with the transcript id at once (status queued); the\n// page then polls GET sales-outreach/transcript?id=... until it is done.\nconst up = $('AssemblyAI: upload audio').first().json;\nif (up.error || !up.upload_url) {\n  return { statusCode: 502, body: { error: 'Audio upload failed: ' + String((up.error && up.error.message) || up.error || 'no upload_url'), step: 'AssemblyAI: upload audio' } };\n}\nconst t = $input.first().json;\nif (t.error || !t.id) {\n  return { statusCode: 502, body: { error: 'Could not start the transcript: ' + String((t.error && t.error.message) || t.error || 'no id'), step: 'AssemblyAI: start transcript' } };\n}\nreturn { statusCode: 200, body: { success: true, id: t.id, status: t.status } };\n"
   }
  },
