      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Eclipse answers the print call before the ticket prints; the page then\n// watches the change log for \"Printed \u2026 Ticket on printer \u2026\".\nconst c = $('Check status').first().json;\nconst r = $input.first().json;\nif (r.error) {\n  return [{ json: { statusCode: 502, body: { success: false, step: 'printTicket',\n    error: 'Eclipse POST /WarehouseTasks/PrintTicket/' + c.eSorderId + ' failed: ' + r.error + ' ' + JSON.stringify(r.message || '').substring(0, 500) } } }];\n}\nreturn [{ json: { statusCode: 200, body: {\n  success: true,\n  action: 'print',\n  e_sorder_id: c.eSorderId,\n  order_id: c.eSorderId.split('.')[0],\n  printer_id: Number(c.printerId),\n} } }];\n"
