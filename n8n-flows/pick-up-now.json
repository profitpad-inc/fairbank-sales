    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// invoice needs PickUpNow (the page sets it with create-order / update-bid\n// first); print needs Invoice (after the invoice call).\nconst v = $('Validate').first().json;\nconst env = $input.first().json;\nconst fail = (statusCode, error, step) => [{ json: { ok: false, statusCode, body: { success: false, error, step } } }];\nif (env.error) return fail(502, 'Eclipse GET /SalesOrders?id=' + v.oid + ' failed: ' + env.error + ' ' + JSON.stringify(env.message || '').substring(0, 500), 'getSalesOrder');\nconst so = (Array.isArray(env.results) ? env.results[0] : env) || {};\nif (!Array.isArray(so.generations) || !so.generations.length) return fail(404, 'Eclipse order ' + v.oid + ' not found.', 'getSalesOrder');\nconst gen = so.generations.find((g) => String(g.generationId) === v.genId);\nif (!gen) return fail(404, 'Order ' + v.oid + ' has no generation ' + v.genId + '.', 'getSalesOrder');\nconst status = String(gen.status || '');\nconst want = v.action === 'invoice' ? 'PickUpNow' : 'Invoice';\nif (status !== want) {\n  return fail(409, v.eSorderId + ' is ' + (status || 'in no status') + ', not ' + want + ', so it cannot be ' +\n    (v.action === 'invoice' ? 'invoiced' : 'printed') + ' here.', 'checkStatus');\n}\nreturn [{ json: { ok: true, action: v.action, eSorderId: v.eSorderId, printerId: v.printerId, previousStatus: status } }];\n"
      },
