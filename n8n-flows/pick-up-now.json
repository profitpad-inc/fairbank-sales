      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Body: { e_sorder_id, writer, action, printer_id? }.\n// action 'invoice': the generation must be PickUpNow; sets it to Invoice.\n// action 'print': the generation must be Invoice; prints its ticket on printer_id.\nconst parseId = (raw) => {\n  const m = String(raw || '').trim().toUpperCase().match(/^S?(\\d+)(?:\\.(\\d{1,4}))?$/);\n  if (!m) return null;\n  const oid = 'S' + m[1];\n  const genId = String(Number(m[2] || 1));\n  return { oid, genId, eSorderId: oid + '.' + genId.padStart(4, '0') };\n};\nconst b = $input.first().json.body || {};\nconst fail = (msg) => [{ json: { ok: false, statusCode: 400, body: { success: false, error: msg, step: 'validate' } } }];\nconst id = parseId(b.e_sorder_id);\nif (!id) return fail('Missing or invalid e_sorder_id (expected S1234567.0001).');\nif (!b.writer) return fail('Missing writer (e_user_id)');\nconst action = String(b.action || '').trim().toLowerCase();\nif (action !== 'invoice' && action !== 'print') return fail(\"action must be 'invoice' or 'print'.\");\nlet printerId = '';\nif (action === 'print') {\n  printerId = String(b.printer_id == null ? '' : b.printer_id).trim();\n  if (!/^\\d+$/.test(printerId) || Number(printerId) <= 0) return fail('Missing or invalid printer_id (a printer number).');\n}\nreturn [{ json: { ok: true, ...id, action, printerId, writer: String(b.writer).toUpperCase() } }];\n"
      },
