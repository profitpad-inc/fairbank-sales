    {
      "parameters": {
        "jsCode": "// One Eclipse inventory and pricing call for every product in e_product_id\n// (comma separated, e.g. \"60144,246\"; the Eclipse node is in allInOne mode,\n// so its output is { metadata, results: [...] } or { error }).\n// The top level keeps the old single-product answer (the first product,\n// e_product_id as sent) for the product-inquiry page; products lists every\n// requested product in the order asked, with the same fields.\nconst q = $('Webhook').first().json.query || {};\nconst env = $('E get Inventory & Price').first().json || {};\nconst ids = String(q.e_product_id || '').split(',').map((s) => s.trim()).filter(Boolean);\nconst r2 = (m) => (m && m.value != null && isFinite(Number(m.value)) ? Math.round(Number(m.value) * 100) / 100 : null);\nconst str = (m) => { const v = r2(m); return v == null ? 'error' : String(v); };\n\n// Eclipse error text without its \"400 - \" prefix, as a string the page can\n// JSON.parse (it was inserted raw into the old response body).\nlet errorMessage = '';\nif (env.error && env.error.message) {\n  const raw = String(env.error.message).slice(6, 10000);\n  try {\n    const parsed = JSON.parse(raw);\n    errorMessage = typeof parsed === 'string' ? parsed : raw;\n  } catch (e) {\n    errorMessage = raw;\n  }\n}\n\nconst shape = (p) => ({\n  e_customer_id: String(q.e_customer_id || ''),\n  e_product_id: String(p.productId),\n  unit_price: str(p.unitPrice),\n  unit_cost: str(p.productCost),\n  unit_cogs: str(p.productCOGS),\n  list_price: str(p.listPrice),\n  quantity_breaks: Array.isArray(p.quantityBreaks) && p.quantityBreaks.length\n    ? p.quantityBreaks.map((i) => ({ startQuantity: i.startQuantity, unitPrice: r2(i.unitPrice) }))\n    : [{ startQuantity: 0, unitPrice: r2(p.unitPrice) }],\n  stock_info: Array.isArray(p.stockInfo) ? p.stockInfo : 'error',\n  error_message: '',\n});\nconst failed = (id, msg) => ({\n  e_customer_id: String(q.e_customer_id || ''),\n  e_product_id: String(id),\n  unit_price: 'error', unit_cost: 'error', unit_cogs: 'error', list_price: 'error',\n  quantity_breaks: [],\n  stock_info: 'error',\n  error_message: msg,\n});\n\nconst byId = {};\nfor (const p of (Array.isArray(env.results) ? env.results : [])) byId[String(p.productId)] = p;\nconst products = ids.map((id) => byId[id] ? shape(byId[id])\n  : failed(id, errorMessage || ('Product ' + id + ' was not in the Eclipse pricing inquiry.')));\n\nconst first = products[0] || failed('', errorMessage || 'Missing e_product_id.');\nreturn {\n  \"body\": { ...first, e_product_id: String(q.e_product_id || ''), error_message: errorMessage || first.error_message, products }\n};\n"
      },
