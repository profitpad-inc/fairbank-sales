    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Diff the requested lines against the bid's current lines on this gen.\nconst v = $('Validate').first().json;\nconst env = $input.first().json;\nconst fail = (statusCode, error, step) => [{ json: { ok: false, statusCode, body: { success: false, error, step } } }];\nif (env.error) return fail(502, 'Eclipse GET /SalesOrders?id=' + v.oid + ' failed: ' + env.error + ' ' + JSON.stringify(env.message || '').substring(0, 500), 'getSalesOrder');\nconst so = (Array.isArray(env.results) ? env.results[0] : env) || {};\nif (!Array.isArray(so.generations) || !so.generations.length) return fail(404, 'Eclipse order ' + v.oid + ' not found.', 'getSalesOrder');\nconst gen = so.generations.find((g) => String(g.generationId) === v.genId);\nif (!gen) return fail(404, 'Order ' + v.oid + ' has no generation ' + v.genId + '.', 'getSalesOrder');\nconst status = String(gen.status || '');\n// Lines on this generation with a quantity: { lineId, productId, qty, price, um }.\nconst genLines = [];\nfor (const line of (Array.isArray(so.lines) ? so.lines : [])) {\n  for (const lg of (Array.isArray(line.generations) ? line.generations : [])) {\n    if (String(lg.generationId) !== v.genId) continue;\n    const qty = (Number(lg.stockQty) || 0) + (Number(lg.nonstockQty) || 0);\n    if (qty <= 0) continue;\n    genLines.push({\n      lineId: line.lineId, productId: String(line.productId), qty,\n      price: lg.price && lg.price.value != null ? Number(lg.price.value) : null,\n      // Line cost and COGS as saved on the order (null when restricted / missing).\n      cost: lg.cost && lg.cost.value != null ? Number(lg.cost.value) : null,\n      cogs: lg.cogs && lg.cogs.value != null ? Number(lg.cogs.value) : null,\n      um: line.displayUom || line.smallestUom || 'ea', umQuantity: Number(line.displayUomQty) || 1,\n      description: String(line.productDescription || line.productDecription || '').replace(/\\s*\\n\\s*/g, ' ').trim(),\n      lineStatus: String(line.status || ''),\n    });\n  }\n}\nif (status !== 'Bid') return fail(409, 'Order ' + v.eSorderId + ' is ' + (status || 'not a bid') + ', not a Bid. Only bids can be edited.', 'plan');\nconst byId = {};\nfor (const l of genLines) byId[String(l.lineId)] = l;\nconst kept = new Set();\nconst posts = [], puts = [], prices = [], changes = { added: [], qty: [], price: [], deleted: [] };\nfor (const l of v.lines) {\n  if (l.lineId == null) {\n    const p = { productId: l.productId, quantity: l.quantity, um: 'ea', umQuantity: 1 };\n    if (l.unitPrice != null) p.unitPrice = l.unitPrice;\n    if (l.comments) { p.comments = l.comments; p.commentsId = '1'; }\n    posts.push({ lineItemProduct: p });\n    changes.added.push({ productId: l.productId, quantity: l.quantity, unitPrice: l.unitPrice });\n    continue;\n  }\n  const cur = byId[String(l.lineId)];\n  if (!cur) return fail(409, 'Line ' + l.lineId + ' is no longer on ' + v.eSorderId + '. Reload the bid and try again.', 'plan');\n  if (String(cur.productId) !== String(l.productId)) return fail(409, 'Line ' + l.lineId + ' on ' + v.eSorderId + ' is product ' + cur.productId + ', not ' + l.productId + '. Reload the bid and try again.', 'plan');\n  kept.add(String(l.lineId));\n  if (l.quantity !== cur.qty) {\n    puts.push({ lineId: Number(l.lineId), qty: l.quantity, um: cur.um });\n    changes.qty.push({ lineId: l.lineId, from: cur.qty, to: l.quantity });\n  }\n  if (l.unitPrice != null && (cur.price == null || Math.abs(l.unitPrice - cur.price) >= 0.0005)) {\n    prices.push({ lineId: Number(l.lineId), value: l.unitPrice });\n    changes.price.push({ lineId: l.lineId, from: cur.price, to: l.unitPrice });\n  }\n}\nconst deletes = genLines.filter((l) => !kept.has(String(l.lineId))).map((l) => l.lineId);\nfor (const id of deletes) changes.deleted.push({ lineId: id, productId: byId[String(id)].productId });\nif (!posts.length && !puts.length && !prices.length && !deletes.length) {\n  // Nothing to change: answer straight away (ok: false only routes to Respond).\n  return [{ json: { ok: false, statusCode: 200, body: { success: true, unchanged: true, e_sorder_id: v.eSorderId, order_id: v.oid } } }];\n}\nreturn [{ json: {\n  ok: true, eSorderId: v.eSorderId, changes,\n  plan: { posts, puts, prices, deleteIds: deletes.join(',') },\n  hasPosts: posts.length > 0, hasPuts: puts.length > 0, hasPrices: prices.length > 0, hasDeletes: deletes.length > 0,\n} }];\n"
      },
