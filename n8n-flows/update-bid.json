    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Body: { e_sorder_id, writer, lines: [{ line_id?, productId, quantity, unitPrice?, comments? }] }\n// comments is only used on new lines (no line_id).\n// `lines` is the complete list the bid should end up with. A line_id is an\n// existing Eclipse line (qty and/or price may change); no line_id is a new\n// line. Existing lines left out are deleted. Only lines change: the header,\n// status and customers stay as they are.\nconst parseId = (raw) => {\n  const m = String(raw || '').trim().toUpperCase().match(/^S?(\\d+)(?:\\.(\\d{1,4}))?$/);\n  if (!m) return null;\n  const oid = 'S' + m[1];\n  const genId = String(Number(m[2] || 1));\n  return { oid, genId, eSorderId: oid + '.' + genId.padStart(4, '0') };\n};\nconst b = $input.first().json.body || {};\nconst fail = (msg) => [{ json: { ok: false, statusCode: 400, body: { success: false, error: msg, step: 'validate' } } }];\nconst id = parseId(b.e_sorder_id);\nif (!id) return fail('Missing or invalid e_sorder_id (expected S1234567.0001).');\nif (!b.writer) return fail('Missing writer (e_user_id)');\nconst lines = (Array.isArray(b.lines) ? b.lines : []).map((l) => ({\n  lineId: l.line_id != null && l.line_id !== '' ? Number(l.line_id) : null,\n  productId: Number(l.productId),\n  quantity: Math.round(Number(l.quantity) || 0),\n  unitPrice: l.unitPrice != null && l.unitPrice !== '' && isFinite(Number(l.unitPrice)) ? Number(l.unitPrice) : null,\n  comments: String(l.comments == null ? '' : l.comments).trim(),\n})).filter((l) => l.productId && l.quantity > 0);\nif (!lines.length) return fail('A bid needs at least one line. Cancel the bid to remove it.');\nreturn [{ json: { ok: true, ...id, writer: String(b.writer).toUpperCase(), lines } }];\n"
      },
