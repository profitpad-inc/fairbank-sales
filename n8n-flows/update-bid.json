    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const v = { eSorderId: $('Plan').first().json.eSorderId };\nconst plan = $('Plan').first().json;\nlet r = $input.first().json || {};\n// A non-JSON content type lands the body in `data` as text; parse it.\nif (!r.orders && typeof r.data === 'string') { try { r = JSON.parse(r.data); } catch (e) {} }\n// update-hs-deal answers { message, source, orders: [{ <hs_deal_id>: <e_sorder_id> }] }.\nconst pairs = [];\nfor (const o of (Array.isArray(r.orders) ? r.orders : [])) {\n  for (const [dealId, soId] of Object.entries(o || {})) pairs.push([String(dealId), String(soId)]);\n}\nconst base = (id) => String(id || '').split('.')[0].toUpperCase();\nconst hit = pairs.find((p) => p[1] === v.eSorderId) || pairs.find((p) => base(p[1]) === base(v.eSorderId)) || (pairs.length === 1 ? pairs[0] : null);\nconst hubspotSync = r.error ? { ok: false, error: String(r.error) } : { ok: true, orders: r.orders || null };\nreturn [{ json: { statusCode: 200, body: {\n  success: true,\n  e_sorder_id: v.eSorderId,\n  order_id: v.eSorderId.split('.')[0],\n  hs_deal_id: hit ? hit[0] : '',\n  changes: plan.changes,\n  hubspot_sync: hubspotSync,\n} } }];\n"
      },
