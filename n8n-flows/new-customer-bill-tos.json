    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Same shape as product-inquiry's customer search ({ e_customers: [{\n// e_customer_id, name }] }), so the page's list code is shared. The flag is\n// checked again here in case HubSpot's filter lets one through.\nconst r = $input.first().json || {};\nif (r.error) return [{ json: { statusCode: 502, body: { error: 'HubSpot search failed: ' + String(r.error).slice(0, 300) } } }];\nconst e_customers = (r.results || [])\n  .map((c) => c.properties || {})\n  .filter((p) => p.e_customer_id && String(p.billto_shipto_flag || '').split(';').includes('bill_to'))\n  .map((p) => ({ e_customer_id: String(p.e_customer_id), name: String(p.name || '') }));\nreturn [{ json: { statusCode: 200, body: { e_customers } } }];\n"
      },
