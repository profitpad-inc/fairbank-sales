    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Bill-to search for the New customer form (a ship-to's bill-to): HubSpot\n// companies whose billto_shipto_flag contains bill_to and that have an\n// Eclipse id. ?q=acme (free text: name, domain, phone) or ?q=.12345 / 12345\n// (Eclipse id).\nconst q = String(($input.first().json.query || {}).q || '').trim().slice(0, 100);\nif (q.replace(/^\\./, '').length < 2) return [{ json: { ok: false, statusCode: 400, body: { error: 'Type at least 2 characters' } } }];\nconst filters = [\n  { propertyName: 'billto_shipto_flag', operator: 'CONTAINS_TOKEN', value: 'bill_to' },\n  { propertyName: 'e_customer_id', operator: 'HAS_PROPERTY' },\n];\nconst id = (q.match(/^\\.?(\\d+)$/) || [])[1];\nif (id) filters.push({ propertyName: 'e_customer_id', operator: 'EQ', value: id });\nreturn [{ json: { ok: true, filter: { filterGroups: [{ filters }] }, query: id ? '' : q } }];\n"
      },
