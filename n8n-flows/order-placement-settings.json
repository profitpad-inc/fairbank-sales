    {
      "id": "30258def-f544-4aa0-bce0-ed79ccf2f3fa",
      "name": "Shape",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [448, 0],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Settings the order placement page reads once per page load, keyed by\n// setting_id: { ship_vias_by_branch: { branches, branch_count, refreshed_at } }.\n// A missing row is left out (the page then offers every ship via).\nconst body = {};\nfor (const it of $input.all()) {\n  const r = it.json || {};\n  if (!r.setting_id) continue;\n  let d = r.data;\n  if (typeof d === 'string') { try { d = JSON.parse(d); } catch (e) { d = null; } }\n  if (d) body[r.setting_id] = d;\n}\nreturn { body };"
      }
    },
    {
      "id": "6a7499f4-31b2-48e7-aca8-f24b0f4a7f65",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [672, 0],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json.body) }}",
        "options": {}
      }
    }
  ],
  "connections": {
    "Webhook": {
      "main": [[{ "node": "read settings", "type": "main", "index": 0 }]]
    },
    "read settings": {
      "main": [[{ "node": "Shape", "type": "main", "index": 0 }]]
    },
    "Shape": {
      "main": [[{ "node": "Respond", "type": "main", "index": 0 }]]
    }
  }
}
