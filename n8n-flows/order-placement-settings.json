    {
      "id": "95cbdc5b-3d53-4e90-99d2-cfa2d8535e79",
      "name": "read settings",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [224, 0],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT setting_id, data FROM fairbank_sales_settings WHERE setting_id IN ('ship_vias_by_branch');",
