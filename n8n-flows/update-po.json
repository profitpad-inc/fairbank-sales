    {
      "parameters": {
        "jsCode": "// A change log comment on the generation: what changed (the PO's old and new\n// value; instructions and notes by name only, they can be long), who changed\n// it and from where (same wording as the other order placement flows).\nconst v = $('Validate').first().json;\nconst c = $('Check status').first().json;\nconst parts = [];\nif (c.changes.po) parts.push('PO changed from \"' + (c.changes.po.from || '(blank)') + '\" to \"' + (c.changes.po.to || '(blank)') + '\"');\nif (c.changes.instructions) parts.push('shipping instructions changed');\nif (c.changes.notes) parts.push('internal notes changed');\nconst text = parts.join(', ');\nconst comment = text.charAt(0).toUpperCase() + text.slice(1) + ' by ' + v.writer + ' from the HubSpot Order Placement Webtool';\nreturn [{ json: { orderId: c.eSorderId, comment } }];\n"
      },
