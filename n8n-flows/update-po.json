    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Body: { e_sorder_id, writer, po?, shipping_instructions?, internal_notes? }.\n// Sets the PO number, shipping instructions and internal notes of that\n// generation (2026-11-06, on request: any order that is not invoiced or\n// cancelled; instructions and notes added the same day). A field left out\n// (null) keeps Eclipse's value; blank clears it (a blank PO was tested and\n// works). At least one field must be sent.\nconst parseId = (raw) => {\n  const m = String(raw || '').trim().toUpperCase().match(/^S?(\\d+)(?:\\.(\\d{1,4}))?$/);\n  if (!m) return null;\n  const oid = 'S' + m[1];\n  const genId = String(Number(m[2] || 1));\n  return { oid, genId, eSorderId: oid + '.' + genId.padStart(4, '0') };\n};\nconst b = $input.first().json.body || {};\nconst fail = (msg) => [{ json: { ok: false, statusCode: 400, body: { success: false, error: msg, step: 'validate' } } }];\nconst id = parseId(b.e_sorder_id);\nif (!id) return fail('Missing or invalid e_sorder_id (expected S1234567.0001).');\nif (!b.writer) return fail('Missing writer (e_user_id)');\nconst text = (v) => (v == null ? null : String(v).trim());\nconst want = { po: text(b.po), instructions: text(b.shipping_instructions), notes: text(b.internal_notes) };\nif (want.po == null && want.instructions == null && want.notes == null) return fail('Nothing to update: send po, shipping_instructions or internal_notes.');\nif (want.po != null && want.po.length > 30) return fail('The PO can be 30 characters at most.');\nreturn [{ json: { ok: true, ...id, writer: String(b.writer).toUpperCase(), want } }];\n"
      },
