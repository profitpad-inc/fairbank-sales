        "jsCode": "// A failed comment never fails the update (the changes are saved); it is\n// kept here for troubleshooting. The deal sync reads e_sorder_ids.\nconst id = $('Check status').first().json.eSorderId;\nconst r = $input.first().json;\nreturn [{ json: { e_sorder_ids: [id], changelog_error: r.error ? id + ': ' + r.error : '' } }];\n"
      },
