    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Invoice and Cancel are final; any other status (Bid included) can take a\n// new PO, shipping instructions and internal notes. Only the fields that\n// differ from the generation are changed; none → 200 unchanged straight away.\nconst v = $('Validate').first().json;\nconst env = $input.first().json;\nconst fail = (statusCode, error, step) => [{ json: { ok: false, statusCode, body: { success: false, error, step } } }];\nif (env.error) return fail(502, 'Eclipse GET /SalesOrders?id=' + v.oid + ' failed: ' + env.error + ' ' + JSON.stringify(env.message || '').substring(0, 500), 'getSalesOrder');\nconst so = (Array.isArray(env.results) ? env.results[0] : env) || {};\nif (!Array.isArray(so.generations) || !so.generations.length) return fail(404, 'Eclipse order ' + v.oid + ' not found.', 'getSalesOrder');\nconst gen = so.generations.find((g) => String(Number(g.generationId)) === v.genId);\nif (!gen) return fail(404, 'Order ' + v.oid + ' has no generation ' + v.genId + '.', 'getSalesOrder');\nconst status = String(gen.status || '');\nif (status === 'Invoice') return fail(409, v.eSorderId + ' is invoiced and can no longer be changed.', 'checkStatus');\nif (status === 'Cancel') return fail(409, v.eSorderId + ' is cancelled and can no longer be changed.', 'checkStatus');\nconst trim = (s) => String(s == null ? '' : s).trim();\nconst cur = { po: trim(gen.poNumber), instructions: trim(gen.shippingInstructions), notes: trim(gen.internalNotes) };\nconst changes = {};\nfor (const k of ['po', 'instructions', 'notes']) {\n  if (v.want[k] != null && v.want[k] !== cur[k]) changes[k] = { from: cur[k], to: v.want[k] };\n}\nif (!Object.keys(changes).length) {\n  return [{ json: { ok: false, statusCode: 200, body: { success: true, unchanged: true, e_sorder_id: v.eSorderId, order_id: v.oid } } }];\n}\nconst has = { po: !!changes.po, instructions: !!changes.instructions, notes: !!changes.notes };\nreturn [{ json: { ok: true, eSorderId: v.eSorderId, status, changes, has } }];\n"
      },
