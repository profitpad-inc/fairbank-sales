    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const c = $('Check status').first().json;\nlet r = $('Trigger HubSpot deal sync').first().json || {};\n// A non-JSON content type lands the body in `data` as text; parse it.\nif (!r.orders && typeof r.data === 'string') { try { r = JSON.parse(r.data); } catch (e) {} }\n// update-hs-deal answers { message, source, orders: [{ <hs_deal_id>: <e_sorder_id> }] }.\nconst pairs = [];\nfor (const o of (Array.isArray(r.orders) ? r.orders : [])) {\n  for (const [dealId, soId] of Object.entries(o || {})) pairs.push([String(dealId), String(soId)]);\n}\nconst base = (id) => String(id || '').split('.')[0].toUpperCase();\nconst hit = pairs.find((p) => p[1] === c.eSorderId) || pairs.find((p) => base(p[1]) === base(c.eSorderId)) || (pairs.length === 1 ? pairs[0] : null);\nconst hubspotSync = r.error ? { ok: false, error: String(r.error) } : { ok: true, orders: r.orders || null };\nreturn [{ json: { statusCode: 200, body: {\n  success: true,\n  e_sorder_id: c.eSorderId,\n  order_id: c.eSorderId.split('.')[0],\n  status: c.status,\n  changes: c.changes,\n  hs_deal_id: hit ? hit[0] : '',\n  hubspot_sync: hubspotSync,\n} } }];\n"
      },
