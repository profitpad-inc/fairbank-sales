        "jsCode": "const c = $('Check status').first().json;\nconst r = $input.first().json;\nif (r.error) {\n  return [{ json: { ok: false, statusCode: 502, body: { success: false, step: 'updatePONumber', changes: c.changes,\n    error: 'Eclipse PUT PO number failed on ' + c.eSorderId + ': ' + r.error + ' ' + JSON.stringify(r.message || '').substring(0, 500) +\n      ' Some changes may already be saved; reload the order to see where it stands.' } } }];\n}\nreturn [{ json: { ok: true } }];\n"
