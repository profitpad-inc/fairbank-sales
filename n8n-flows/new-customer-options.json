    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// HubSpot company dropdowns for the New customer form, read on every page\n// open so new HubSpot options show without a page change. With\n// ?e_customer_id= (a new ship-to on that bill-to) it also returns the\n// bill-to's domain, industry and propane flag to pre-fill the form.\nconst opts = (name) => {\n  const r = $(name).first().json;\n  if (!r || r.error || !Array.isArray(r.options)) return null;\n  return r.options\n    .filter((o) => !o.hidden && o.value != null && String(o.value).trim())\n    .map((o, i) => ({ label: String(o.label || o.value), value: String(o.value), order: o.displayOrder == null ? i : o.displayOrder, i }))\n    .sort((a, b) => (a.order - b.order) || (a.i - b.i))\n    .map((o) => ({ label: o.label, value: o.value }));\n};\nconst states = opts('HubSpot: state options');\nconst industries = opts('HubSpot: industry options');\nif (!states) {\n  const r = $('HubSpot: state options').first().json || {};\n  return [{ json: { statusCode: 502, body: { error: 'HubSpot state options failed: ' + (r.error || 'no options') } } }];\n}\n\nlet bill_to = null;\nif ($('Has bill-to?').isExecuted && $('HubSpot: bill-to company').isExecuted) {\n  const c = $('HubSpot: bill-to company').first().json || {};\n  const p = c.properties || {};\n  if (!c.error && c.objectFound !== false && p) {\n    bill_to = {\n      e_customer_id: String(p.e_customer_id || ''),\n      hs_id: String(c.id || p.hs_object_id || ''),\n      domain: p.domain || '',\n      industry: p.industry || '',\n      e_propane_customer: p.e_propane_customer || '',\n    };\n  }\n}\n\nreturn [{ json: { statusCode: 200, body: { states, industries: industries || [], bill_to } } }];\n"
      },
