        "mode": "runOnceForAllItems",
        "jsCode": "// Body: { e_sorder_id, comment, writer }. Adds one comment to that\n// generation's change log. Eclipse records the API account as the user, so\n// the comment is sent as \"<writer>: <comment>\" to show who wrote it.\nconst b = $input.first().json.body || {};\nconst fail = (msg) => [{ json: { ok: false, statusCode: 400, body: { success: false, error: msg, step: 'validate' } } }];\nconst m = String(b.e_sorder_id || '').trim().toUpperCase().match(/^S?(\\d+)\\.(\\d{1,4})$/);\nif (!m) return fail('Missing or invalid e_sorder_id (expected S1234567.0001, with the generation).');\nconst comment = String(b.comment || '').trim();\nif (!comment) return fail('Missing comment.');\nif (!b.writer) return fail('Missing writer (e_user_id)');\nconst writer = String(b.writer).trim().toUpperCase();\nconst eSorderId = 'S' + m[1] + '.' + m[2].padStart(4, '0');\nreturn [{ json: { ok: true, oid: 'S' + m[1], eSorderId, writer, comment: writer + ': ' + comment } }];\n"
      },
