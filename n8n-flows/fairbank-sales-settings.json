      "parameters": {
        "operation": "executeQuery",
        "query": "-- Same shape as outlook_integration_settings. Safe to re-run: never drops anything.\n-- Shared trigger function (same body as the one the outlook tables use)\nCREATE OR REPLACE FUNCTION set_row_updated_at()\nRETURNS TRIGGER AS $$\nBEGIN\n  NEW.row_updated_at = now();\n  RETURN NEW;\nEND;\n$$ LANGUAGE plpgsql;\n\nCREATE TABLE IF NOT EXISTS fairbank_sales_settings (\n  setting_id     TEXT PRIMARY KEY,\n  data           JSONB,\n  row_created_at TIMESTAMPTZ NOT NULL DEFAULT now(),\n  row_updated_at TIMESTAMPTZ NOT NULL DEFAULT now()\n);\n\nDROP TRIGGER IF EXISTS trg_fairbank_sales_settings_row_updated_at ON fairbank_sales_settings;\n\nCREATE TRIGGER trg_fairbank_sales_settings_row_updated_at\nBEFORE UPDATE ON fairbank_sales_settings\nFOR EACH ROW\nEXECUTE FUNCTION set_row_updated_at();",
        "options": {}
      },
