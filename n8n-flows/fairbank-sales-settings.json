    {
      "id": "2c3fdb53-1106-4aa6-b232-e2aee160eebf",
      "name": "Build ship vias by branch",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        256
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Eclipse Get many branches -> { branches: { \"<branch id>\": [ship via ids, A to Z] } }\n// Accepts the envelope ({ metadata, results }) or one branch per item.\nconst branchList = [];\nlet total = null;\nfor (const item of $input.all()) {\n  const j = item.json || {};\n  if (Array.isArray(j.results)) {\n    branchList.push(...j.results);\n    if (j.metadata && j.metadata.totalItems != null) total = Number(j.metadata.totalItems);\n  } else if (j.id != null) {\n    branchList.push(j);\n  }\n}\n\nif (!branchList.length) {\n  throw new Error('Eclipse returned no branches; ship_vias_by_branch left unchanged');\n}\nif (total != null && total > branchList.length) {\n  throw new Error(`Eclipse has ${total} branches but only ${branchList.length} came back (raise the page size); ship_vias_by_branch left unchanged`);\n}\n\nconst branches = {};\nfor (const b of branchList) {\n  const id = String(b.id || '').trim();\n  if (!id) continue;\n  const vias = (b.shipViaOverrides || [])\n    .map(o => String((o && o.shipViaId) || '').trim())\n    .filter(Boolean);\n  branches[id] = [...new Set(vias)].sort();\n}\n\nreturn {\n  \"setting_id\": \"ship_vias_by_branch\",\n  \"data\": {\n    \"branches\": branches,\n    \"branch_count\": Object.keys(branches).length,\n    \"refreshed_at\": new Date().toISOString()\n  }\n};"
      }
    },
