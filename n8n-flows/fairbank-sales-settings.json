        "operation": "executeQuery",
        "query": "-- Branches only some Eclipse users (e_user_id) may use in order placement.\n-- { branches: { \"<branch id>\": [e_user_id, ...] } }. A branch not listed is open to everyone.\n-- Edit this and run setup again to change it.\nINSERT INTO fairbank_sales_settings (setting_id, data)\nVALUES ('branch_users', '{\"branches\": {\"13\": [\"RAMSTE\"], \"18\": [\"VASRAU\"]}}'::jsonb)\nON CONFLICT (setting_id) DO UPDATE SET data = EXCLUDED.data\nRETURNING setting_id, data;",
