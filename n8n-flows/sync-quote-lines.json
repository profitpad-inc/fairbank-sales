    {
      "parameters": {
        "jsCode": "// One item per updated deal that has a quote: the deal's line items as the\n// quote should have them (same copy rules as create-quote), plus the deal's\n// quote ids. A line item can belong to only one record, so quote lines carry\n// the deal line's e_sorder_line_id with a \"Q.\" prefix; that is the key the\n// sync matches on. Plan picks which quote to sync once the quotes are read.\nconst COPY = ['name', 'description', 'hs_sku', 'quantity', 'price', 'hs_cost_of_goods_sold', 'hs_product_id', 'e_uom', 'e_uom_qty', 'e_product_id_'];\nconst num = (x) => (x == null || x === '' || isNaN(Number(x)) ? Infinity : Number(x));\nconst lineNo = (p) => {\n  if (p.e_sorder_line_number != null && p.e_sorder_line_number !== '') return num(p.e_sorder_line_number);\n  const m = String(p.e_sorder_line_id || '').match(/\\.(\\d+)$/);\n  return m ? Number(m[1]) : Infinity;\n};\nconst qKey = (p) => (p.e_sorder_line_id ? 'Q.' + p.e_sorder_line_id : 'Q.H' + p.hs_object_id);\nconst out = [];\nconst items = $input.all();\nfor (let i = 0; i < items.length; i++) {\n  const r = items[i].json || {};\n  const d = $('stop if no quote').itemMatching(i).json || {};\n  const quoteIds = [...new Set((((d.associations || {}).quotes || {}).results || []).map((q) => String(q.id)).filter(Boolean))];\n  if (!quoteIds.length) continue;\n  const lines = (Array.isArray(r.results) ? r.results : [])\n    .filter((l) => !l.archived)\n    .map((l) => Object.assign({ hs_object_id: String(l.id) }, l.properties || {}))\n    .filter((l) => Number(l.quantity) > 0)\n    .sort((x, y) => lineNo(x) - lineNo(y));\n  // A deal with no lines is more likely mid-sync than empty: leave the quote alone.\n  if (!lines.length) continue;\n  const desired = lines.map((l, idx) => {\n    const props = { e_sorder_line_id: qKey(l), hs_position_on_quote: String(idx) };\n    for (const k of COPY) props[k] = l[k] == null ? '' : String(l[k]);\n    return props;\n  });\n  out.push({ json: { dealId: String(d.id), e_sorder_id: (d.properties || {}).e_sorder_id || '', quoteIds, desired } });\n}\nreturn out;\n"
      },
