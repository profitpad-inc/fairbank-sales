    {
      "parameters": {
        "jsCode": "// Upserted lines not already on their quote (new ones, or a Q. line left\n// over from an earlier failed run) get linked to it: quote → line item, 67.\nconst plan = $('Plan').first().json;\nconst linked = new Set(plan.linkedIds);\nconst rows = $input.all().flatMap((i) => (Array.isArray(i.json.results) ? i.json.results : [i.json]));\nconst inputs = [];\nfor (const r of rows) {\n  const id = r && r.id ? String(r.id) : '';\n  const quoteId = plan.quoteByKey[((r && r.properties) || {}).e_sorder_line_id];\n  if (!id || !quoteId || linked.has(id)) continue;\n  inputs.push({ from: { id: quoteId }, to: { id }, types: [{ associationCategory: 'HUBSPOT_DEFINED', associationTypeId: 67 }] });\n}\n// No throw here: the quote is still republished, and Check fails the run after.\n// (Check reports a failed upsert itself; this only adds a short answer.)\nconst failed = rows.some((r) => r && r.error);\nconst errors = !failed && rows.length < plan.upsertBody.inputs.length ? ['HubSpot upserted ' + rows.length + ' of ' + plan.upsertBody.inputs.length + ' quote lines.'] : [];\nreturn [{ json: { link: !failed && !errors.length && inputs.length > 0, body: { inputs }, errors } }];\n"
      },
