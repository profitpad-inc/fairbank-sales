    {
      "parameters": {
        "jsCode": "// The quote is republished whatever happened to its lines, so a customer's\n// link never stays down. Any line step that failed fails the run here, after\n// that, so the execution shows as failed with what went wrong.\nconst errs = [];\nconst from = (name) => {\n  let items = [];\n  try { items = $(name).all(); } catch (e) { return; } // node didn't run\n  for (const i of items) if (i.json && i.json.error) errs.push(name + ': ' + (typeof i.json.error === 'string' ? i.json.error : JSON.stringify(i.json.error)).substring(0, 300));\n};\nfrom('HubSpot: archive lines');\nfrom('HubSpot: upsert lines');\nfrom('HubSpot: link lines');\ntry { for (const e of $('Link').first().json.errors || []) errs.push('Link: ' + e); } catch (e) {}\nif (errs.length) throw new Error('Quote lines not fully synced (quote republished): ' + errs.join(' | '));\nreturn [{ json: { success: true, summary: $('Plan').first().json.summary } }];\n"
      },
