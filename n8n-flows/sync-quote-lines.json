    {
      "parameters": {
        "jsCode": "// Diff the deal's newest quote (the one View Quote shows; two quotes on one\n// deal cannot both hold the same Q. id) against the deal: upsert lines that\n// are new or changed (matched on the Q. id), archive quote lines the deal no\n// longer has (and duplicates, and lines from before the Q. ids). Unchanged\n// lines are left alone, so a deal update that touched no line writes nothing.\n// A published quote's lines can't change, so a quote with changes is set to\n// DRAFT first and back to its own status afterwards (unpublishBody /\n// republishBody); quotes with no changes are not touched.\nconst COMPARE = ['name', 'description', 'hs_sku', 'quantity', 'price', 'hs_cost_of_goods_sold', 'hs_product_id', 'e_uom', 'e_uom_qty', 'e_product_id_', 'hs_position_on_quote'];\nconst blank = (x) => x == null || x === '';\nconst same = (x, y) => {\n  if (blank(x) && blank(y)) return true;\n  if (blank(x) || blank(y)) return false;\n  const nx = Number(x), ny = Number(y);\n  if (!isNaN(nx) && !isNaN(ny)) return Math.abs(nx - ny) < 1e-9;\n  return String(x) === String(y);\n};\nconst current = {};\nfor (const item of $('HubSpot: quote lines').all()) {\n  const q = item.json || {};\n  const id = String(q.id || (q.properties || {}).hs_object_id || '');\n  if (id && !q.archived) current[id] = {\n    created: String((q.properties || {}).hs_createdate || ''),\n    status: String((q.properties || {}).hs_status || ''),\n    lines: ((q.associations || {})['0-8'] || []).map((l) => l.properties || {}).filter((l) => l.hs_object_id),\n  };\n}\nconst inputs = [], deleteIds = [], quoteByKey = {}, linkedIds = [], summary = [], unpublish = [], republish = [];\nfor (const item of $('Pick quote').all()) {\n  const { dealId, e_sorder_id, quoteIds, desired } = item.json;\n  const quoteId = quoteIds.filter((id) => current[id]).sort((x, y) => current[y].created.localeCompare(current[x].created))[0];\n  if (!quoteId) continue;\n  const have = current[quoteId].lines;\n  const byKey = {};\n  for (const l of have) {\n    linkedIds.push(String(l.hs_object_id));\n    const k = l.e_sorder_line_id;\n    if (k && !byKey[k]) byKey[k] = l; else deleteIds.push(String(l.hs_object_id));\n  }\n  const want = new Set(desired.map((x) => x.e_sorder_line_id));\n  let removed = 0;\n  for (const [k, l] of Object.entries(byKey)) if (!want.has(k)) { deleteIds.push(String(l.hs_object_id)); removed++; }\n  removed += have.length - Object.keys(byKey).length;\n  let changed = 0;\n  for (const props of desired) {\n    const key = props.e_sorder_line_id;\n    quoteByKey[key] = quoteId;\n    const cur = byKey[key];\n    const diff = COMPARE.filter((k) => !same(props[k], cur ? cur[k] : null));\n    if (cur && !diff.length) continue;\n    const send = { e_sorder_line_id: key };\n    for (const k of COMPARE) if (!cur ? !blank(props[k]) : diff.includes(k)) send[k] = props[k];\n    inputs.push({ idProperty: 'e_sorder_line_id', id: key, properties: send });\n    changed++;\n  }\n  const status = current[quoteId].status;\n  if (changed || removed) {\n    unpublish.push({ id: quoteId, properties: { hs_status: 'DRAFT' } });\n    // A status the read didn't return would leave the quote a draft: republish as published.\n    republish.push({ id: quoteId, properties: { hs_status: status || 'APPROVAL_NOT_NEEDED' } });\n  }\n  summary.push({ dealId, e_sorder_id, quoteId, status, upserted: changed, archived: removed });\n}\nreturn [{ json: { changes: unpublish.length > 0, unpublishBody: { inputs: unpublish }, republishBody: { inputs: republish }, upsert: inputs.length > 0, upsertBody: { inputs }, archive: deleteIds.length > 0, deleteIds: [...new Set(deleteIds)].join(','), quoteByKey, linkedIds, summary } }];\n"
      },
